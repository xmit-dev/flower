+/* Flower: blocks alive when the host captures a reusable heap image
+   (flower_snapshot_prepare) are immortal. Their reference count is raised to
+   JS_REF_IMMORTAL and never incremented, decremented or freed again, and the
+   cycle collector skips edges to them, so an evaluation that starts from the
+   image reads them without writing to their memory: reading an image
+   object's property, calling an image function or creating an object with an
+   image shape leaves the page it lives on untouched. A 32-bit heap cannot hold
+   2^30 references to one block, so live counts stay below the sentinel. */
+#define JS_REF_IMMORTAL (1 << 30)
+
+static inline bool js_rc_immortal(const void *p)
+{
+    return JS_REF_COUNT(p) >= JS_REF_IMMORTAL;
+}
+
+static inline void js_rc_inc(const void *p)
+{
+    int *count = &JS_REF_COUNT(p);
+    if (likely(*count < JS_REF_IMMORTAL))
+        (*count)++;
+}
+
+/* the decremented count; an immortal block keeps its own */
+static inline int js_rc_dec(const void *p)
+{
+    int *count = &JS_REF_COUNT(p);
+    if (unlikely(*count >= JS_REF_IMMORTAL))
+        return *count;
+    return --*count;
+}
